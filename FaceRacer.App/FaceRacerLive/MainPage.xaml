<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FaceRacerLive" 
             xmlns:viewmodels="clr-namespace:FaceRacerLive.ViewModels"
             x:Class="FaceRacerLive.MainPage"
             x:DataType="viewmodels:RaceMonitorPanelViewModel">

    <!-- Title toolbar -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="6"
              Padding="8,0">

            <!-- left icon -->
            <!--<Image Grid.Column="0"
                   Source="go_kart_logo_2.png"
                   HeightRequest="24"
                   WidthRequest="24"
                   VerticalOptions="Center" />-->

            <!-- Title text  -->
            <Label Grid.Column="1"
                   Margin="-15,0,0,0"
                   Text="Face Racer"
                   TextColor="MediumPurple"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   FontAttributes="Bold" />

            <!-- Sniffer toggle -->
            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="2"
                                   VerticalOptions="Center">

                <CheckBox x:Name="SnifferCheckBox"
                          VerticalOptions="Center"
                          CheckedChanged="OnSnifferCheckedChanged"
                          Margin="-6,0,0,0">
                </CheckBox>

                <Label x:Name="SnifferLabel"
                       Margin="-10,0,0,0"
                       Text="Rec."
                       FontSize="12"
                       VerticalOptions="Center" >
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding Source={x:Reference SnifferCheckBox}, Path=IsChecked}"
                                     Value="True">
                            <Setter Property="TextColor" Value="#ba0d0d" />
                        </DataTrigger>
                    </Label.Triggers>

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSnifferLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>

            </HorizontalStackLayout>

            <!-- Live toggle -->
            <HorizontalStackLayout Grid.Column="3"
                                   Spacing="2"
                                   VerticalOptions="Center">

                <CheckBox x:Name="LiveRaceCheckBox"
                          VerticalOptions="Center"
                          CheckedChanged="OnLiveRaceCheckedChanged"
                          Margin="0,0,0,0" />

                <Label x:Name="LiveLabel"
                       Text="Live"
                       FontSize="12"
                       Margin="-10,0,0,0"
                       VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding Source={x:Reference LiveRaceCheckBox}, Path=IsChecked}"
                                     Value="True">
                            <Setter Property="TextColor" Value="#27ba0d" />
                        </DataTrigger>
                    </Label.Triggers>

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLiveLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>

            </HorizontalStackLayout>

        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="10,16,10,0"
                             Spacing="12">

            <!-- auto-track + name -->
            <Grid ColumnDefinitions="Auto,Auto,*"
                  ColumnSpacing="2"
                  Margin="0,-19,0,0"
                  VerticalOptions="Center"
                  HeightRequest="45">
                <CheckBox x:Name="AutoTrackCheckBox"
                          VerticalOptions="Center" />

                <Label Grid.Column="1"
                       Text="Auto"
                       FontSize="12"
                       Margin="-10,0,0,0"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=DarkGray, Dark=Gray}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label"
                                     Binding="{Binding Source={x:Reference AutoTrackCheckBox}, Path=IsChecked}"
                                     Value="True">
                            <Setter Property="TextColor" Value="#ba0d0d" />
                        </DataTrigger>
                    </Label.Triggers>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAutoTrackLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <Border Grid.Column="2"
                        Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Margin="10,0,0,0"
                        Padding="4,-3"
                        VerticalOptions="Center"
                        HorizontalOptions="Fill">
                    <Entry x:Name="AutoTrackNameEditor"
                           Text="{Binding AutoTrackByName}"
                           Placeholder=""
                           FontSize="11"
                           HeightRequest="34"
                           BackgroundColor="Transparent"
                           TextColor="{AppThemeBinding Light=DarkGray, Dark=Gray}"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center"
                           MaxLength="50"
                           ReturnType="Done" />
                </Border>
            </Grid>

            <Border Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="10,0"
                    Margin="0,-10,0,0"
                    HorizontalOptions="Fill">

                <Editor x:Name="InputTextEditor"
                        Placeholder=""
                        AutoSize="TextChanges"
                        MaxLength="96"
                        FontSize="16"
                        HeightRequest="60"
                        Margin="0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Fill" 
                        Unfocused="OnInputTextEditorUnfocused" />
            </Border>

            <!-- MIC controls -->
            <Grid ColumnDefinitions="*,auto,auto,auto"
                  ColumnSpacing="12">

                <Button x:Name="SendTextBtn"
                        Text="Send"
                        Grid.Column="0"
                        SemanticProperties.Hint="Send text"
                        Clicked="OnSendTextClicked"
                        HorizontalOptions="Fill" />

                <Button x:Name="ShowTextBtn"
                        Text="Show"
                        Grid.Column="1"
                        Clicked="OnShowTextClicked"
                        HorizontalOptions="Fill" />

                <Button x:Name="MicToggleBtn"
                        Grid.Column="2"
                        Text="Mic On"
                        Clicked="OnMicToggleClicked" />

                <Button x:Name="PttBtn"
                        Grid.Column="3"
                        Text="PTT"
                        Pressed="OnPttPressed"
                        Released="OnPttReleased" />
            </Grid>

            <Label x:Name="MicStatusLabel" Text="Idle" IsVisible="False" />

            <!-- Presets Buttons -->
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Button Text="🔵"
                        Clicked="OnPresetClicked"
                        CommandParameter="Próxima limpia"
                        Padding="0"
                        WidthRequest="45"
                        HeightRequest="36"
                        MinimumHeightRequest="36"
                        FontSize="13"
                        CornerRadius="6" />

                <Button Text="🟡🔴"
                        Clicked="OnPresetClicked"
                        CommandParameter="Amarilla precaución"
                        Padding="0"
                        WidthRequest="45"
                        HeightRequest="36"
                        MinimumHeightRequest="36"
                        FontSize="11"
                        CornerRadius="6" />

                <Button Text="🟡🔵"
                        Clicked="OnPresetClicked"
                        CommandParameter="Amarilla limpia"
                        Padding="0"
                        WidthRequest="45"
                        HeightRequest="36"
                        MinimumHeightRequest="36"
                        FontSize="11"
                        CornerRadius="6" />

                <Button Text="🟢"
                        Clicked="OnPresetClicked"
                        CommandParameter="Verde"
                        Padding="0"
                        WidthRequest="45"
                        HeightRequest="36"
                        MinimumHeightRequest="36"
                        FontSize="13"
                        CornerRadius="6" />

                <Button Text="⚫"
                        Clicked="OnPresetClicked"
                        CommandParameter="Negra"
                        Padding="0"
                        WidthRequest="45"
                        HeightRequest="36"
                        MinimumHeightRequest="36"
                        FontSize="14"
                        CornerRadius="6" />
            </HorizontalStackLayout>

            <!-- Session header -->
            <Border Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="10,6"
                    Margin="0,0,0,-12"
                    HorizontalOptions="Fill">

                <Grid ColumnDefinitions="Auto,*,Auto"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="10"
                      VerticalOptions="Center">

                    <Label Grid.Column="0"
                           Text="{Binding SessionTitle}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           LineBreakMode="TailTruncation" />

                    <Label Grid.Column="1"
                           Text="{Binding KartsText}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=DarkGray, Dark=LightGray}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="NoWrap" />

                    <Label Grid.Column="2"
                           Text="{Binding SessionStatusText}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{Binding SessionStatusColor}"
                           HorizontalTextAlignment="End"
                           LineBreakMode="NoWrap" />

                    <ProgressBar Grid.Row="1"
                                 Grid.ColumnSpan="3"
                                 HeightRequest="1"
                                 Margin="0,5,0,0"
                                 Progress="{Binding SessionProgress}"
                                 ProgressColor="{Binding SessionProgressColor}"
                                 BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#303030}" />
                </Grid>
            </Border>

            <!-- Top racers list -->
            <Border Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="8,6"
                    Margin="0,0,0,0"
                    HorizontalOptions="Fill">

                <Grid HeightRequest="275">
                    <CollectionView ItemsSource="{Binding Racers}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:RacerRowViewModel">
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="6,3"
                                        BackgroundColor="Transparent">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter Property="BackgroundColor"
                                                    Value="{AppThemeBinding Light=#FFF5CC, Dark=#3A2F00}" />
                                        </DataTrigger>

                                        <DataTrigger TargetType="Border" Binding="{Binding IsHighlighted}" Value="False">
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid RowDefinitions="Auto,Auto"
                                          ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="6"
                                          RowSpacing="1">

                                        <Label Grid.Row="0"
                                               Grid.Column="0"
                                               Text="{Binding PositionText}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               WidthRequest="28"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center" />

                                        <Label Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding FullName}"
                                               FontSize="9"
                                               LineBreakMode="TailTruncation"
                                               VerticalTextAlignment="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label Grid.Row="0"
                                               Grid.Column="2"
                                               Text="{Binding Kart}"
                                               FontSize="11"
                                               TextColor="{Binding KartColor}"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center" />

                                        <Label Grid.Row="0"
                                               Grid.Column="3"
                                               Text="{Binding LapText}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#665f4d, Dark=#e6d6ac}"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center" />

                                        <Label Grid.Row="0"
                                               Grid.Column="4"
                                               Text="{Binding LastTime}"
                                               TextColor="{AppThemeBinding Light=DarkGray, Dark=Gray}"
                                               FontSize="13"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center" />

                                        <Label Grid.Row="0"
                                               Grid.Column="5"
                                               Text="{Binding BestTime}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center" />

                                        <Label Grid.Row="0"
                                               Grid.Column="6"
                                               Text="{Binding ArrowIcon}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{Binding ArrowColor}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               WidthRequest="14" />

                                        <ProgressBar Grid.Row="1"
                                                     Grid.ColumnSpan="7"
                                                     HeightRequest="2"
                                                     Progress="{Binding LapProgress}"
                                                     ProgressColor="{AppThemeBinding Light=#665f4d, Dark=#e6d6ac}"
                                                     BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#303030}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <!--Console output--> 
            <Border Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="5,0,5,0"
                    Margin="0,0,0,0"
                    HorizontalOptions="Fill">

                <Grid>
                    <ScrollView x:Name="ConsoleScrollView"
                                HeightRequest="105"
                                Orientation="Vertical"
                                Scrolled="OnConsoleScrolled">
                        <VerticalStackLayout x:Name="ConsoleStack" Spacing="1" />
                    </ScrollView>

                    <Button Text="Clear"
                            Padding="0,0"
                            FontSize="10"
                            HeightRequest="24"
                            MinimumHeightRequest="24"
                            WidthRequest="60"
                            Clicked="OnConsoleClearClicked"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,4,0,0"
                            ZIndex="10" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>