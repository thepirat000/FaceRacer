<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FaceRacerLive"
             xmlns:viewmodels="clr-namespace:FaceRacerLive.ViewModels"
             x:Class="FaceRacerLive.MainPage"
             x:DataType="viewmodels:RaceMonitorPanelViewModel">

    <!-- Title toolbar -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="6"
              Padding="6,0">

            <!-- Title text  -->
            <Label Grid.Column="0"
                   Margin="-8,0,0,0"
                   Text="Monitor"
                   TextColor="MediumPurple"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   FontAttributes="Bold" />

            <!-- Auto-track toggle -->
            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="2"
                                   VerticalOptions="Center">

                <CheckBox x:Name="AutoTrackCheckBox"
                          VerticalOptions="Center"
                          Margin="-6,0,0,0"
                          CheckedChanged="OnAutoTrackCheckedChanged" />

                <Label x:Name="AutoTrackLabel"
                       Margin="-10,0,0,0"
                       Text="Auto"
                       FontSize="12"
                       VerticalOptions="Center"
                       TextColor="MediumPurple">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAutoTrackLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- Rec. toggle -->
            <HorizontalStackLayout Grid.Column="2"
                                   Spacing="2"
                                   VerticalOptions="Center">

                <CheckBox x:Name="SnifferCheckBox"
                          VerticalOptions="Center"
                          CheckedChanged="OnSnifferCheckedChanged"
                          Margin="-6,0,0,0">
                </CheckBox>

                <Label x:Name="SnifferLabel"
                       Margin="-10,0,0,0"
                       Text="Rec."
                       FontSize="12"
                       VerticalOptions="Center"
                       TextColor="MediumPurple">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSnifferLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>

            </HorizontalStackLayout>

            <!-- Live toggle -->
            <HorizontalStackLayout Grid.Column="3"
                                   Spacing="2"
                                   VerticalOptions="Center">

                <CheckBox x:Name="LiveRaceCheckBox"
                          VerticalOptions="Center"
                          CheckedChanged="OnLiveRaceCheckedChanged"
                          Margin="-6,0,0,0" />

                <Label x:Name="LiveLabel"
                       Text="Live"
                       FontSize="12"
                       Margin="-10,0,0,0"
                       VerticalOptions="Center"
                       TextColor="MediumPurple">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLiveLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>

            </HorizontalStackLayout>

        </Grid>
    </Shell.TitleView>

    <ScrollView Orientation="Vertical"
                VerticalScrollBarVisibility="Default">

        <Grid Padding="8,-20,8,2"
              RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
              RowSpacing="12">

        <!-- Send Text -->
        <Border Grid.Row="0"
                Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="10,0"
                Margin="0,-10,0,0"
                HorizontalOptions="Fill"
                IsVisible="False">

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">

                <Editor x:Name="InputTextEditor"
                        Grid.Column="0"
                        Placeholder=""
                        AutoSize="TextChanges"
                        MaxLength="96"
                        FontSize="16"
                        HeightRequest="50"
                        Margin="0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Fill"
                        Unfocused="OnInputTextEditorUnfocused" />

                <Button x:Name="SendTextBtn"
                        Grid.Column="1"
                        Text="Send"
                        SemanticProperties.Hint="Send text"
                        Clicked="OnSendTextClicked"
                        Padding="15,0,15,0"
                        MaximumHeightRequest="35"
                        VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Session header -->
        <Border Grid.Row="2"
                Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                BackgroundColor="{AppThemeBinding Light=#111111, Dark=#111111}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="10,6,10,6"
                Margin="0,0,0,-12"
                HorizontalOptions="Fill">

            <Grid ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="10"
                  VerticalOptions="Center">

                <Label Grid.Column="0"
                       Text="{Binding SessionTitle}"
                       FontSize="16"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       LineBreakMode="TailTruncation" />

                <Label Grid.Column="1"
                       Text="{Binding KartsText}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=DarkGray, Dark=LightGray}"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center"
                       LineBreakMode="NoWrap" />

                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="3"
                             HeightRequest="1"
                             Margin="0,5,0,0"
                             Progress="{Binding SessionProgress}"
                             ProgressColor="{Binding SessionProgressColor}"
                             BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#303030}" />
            </Grid>
        </Border>

        <!-- Racers list (fills remaining space) -->
        <Border Grid.Row="3"
                Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                BackgroundColor="{AppThemeBinding Light=#111111, Dark=#111111}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="8,6"
                Margin="0,0,0,0"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">

            <Grid VerticalOptions="Fill">
                <CollectionView ItemsSource="{Binding Racers}"
                                SelectionMode="None"
                                VerticalOptions="Fill"
                                ItemSizingStrategy="MeasureFirstItem">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:RacerRowViewModel">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 6"
                                    Padding="0,0,3,0"
                                    BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="BackgroundColor"
                                                Value="{AppThemeBinding Light=#FFF5CC, Dark=#011566}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsHighlighted}" Value="False">
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="5"
                                      RowSpacing="1">
                                    <Label Grid.Row="0"
                                           Grid.Column="0"
                                           Text="{Binding PositionText}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           WidthRequest="22"
                                           HorizontalTextAlignment="Start"
                                           VerticalTextAlignment="Center" />
                                    <Label Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding FullName}"
                                           FontSize="11"
                                           LineBreakMode="TailTruncation"
                                           VerticalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Grid.Row="0"
                                           Grid.Column="2"
                                           Text="{Binding Kart}"
                                           FontSize="16"
                                           TextColor="{Binding KartColor}"
                                           HorizontalTextAlignment="End"
                                           VerticalTextAlignment="Center" />
                                    <Label Grid.Row="0"
                                           Grid.Column="3"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#665f4d, Dark=#e6d6ac}"
                                           HorizontalTextAlignment="End"
                                           VerticalTextAlignment="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Lap}" FontSize="15" />
                                                <Span Text="/" FontSize="9" />
                                                <Span Text="{Binding TotalLaps}" FontSize="7" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Grid.Row="0"
                                           Grid.Column="4"
                                           Text="{Binding LastTime}"
                                           TextColor="{AppThemeBinding Light=DarkGray, Dark=#adadad}"
                                           FontSize="13"
                                           HorizontalTextAlignment="End"
                                           VerticalTextAlignment="Center">
                                    </Label>
                                    <Label Grid.Row="0"
                                           Grid.Column="5"
                                           Text="{Binding BestTime}"
                                           FontSize="16"
                                           TextColor="#34D399"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="End"
                                           VerticalTextAlignment="Center">
                                    </Label>
                                    <Label Grid.Row="0"
                                           Grid.Column="6"
                                           Text="{Binding ArrowIcon}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{Binding ArrowColor}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           WidthRequest="14" />
                                    <ProgressBar Grid.Row="1"
                                                 Grid.ColumnSpan="7"
                                                 HeightRequest="2"
                                                 Progress="{Binding LapProgress}"
                                                 ProgressColor="{AppThemeBinding Light=#665f4d, Dark=#e6d6ac}"
                                                 BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#303030}" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="2"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.OnRacerDoubleTappedCommand}"
                                                          CommandParameter="{Binding FullName}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="4"
              ColumnDefinitions="auto,auto,auto,auto,auto"
              ColumnSpacing="12"
              Padding="0,0,0,8">

            <Button x:Name="TrackRacerBtn"
                    Text="Track"
                    Grid.Column="0"
                    Clicked="OnTrackClicked"
                    HorizontalOptions="Fill" />

            <Button x:Name="NextSessionsBtn"
                    Text="Next"
                    Grid.Column="1"
                    Clicked="OnNextSessionsClicked"
                    HorizontalOptions="Fill" />

            <Button x:Name="ShowTextBtn"
                    Text="Show"
                    Grid.Column="2"
                    Clicked="OnShowTextClicked"
                    HorizontalOptions="Fill" />

            <Button x:Name="MicToggleBtn"
                    Grid.Column="3"
                    Text="Mic On"
                    FontSize="13"
                    Clicked="OnMicToggleClicked"
                    HorizontalOptions="Fill" />

            <Button x:Name="PttBtn"
                    Grid.Column="4"
                    Text="PTT"
                    Pressed="OnPttPressed"
                    Released="OnPttReleased"
                    IsVisible="False" />
        </Grid>

        <!--Console output-->
        <Border Grid.Row="5"
                Stroke="{AppThemeBinding Light=#C8C8C8, Dark=#404040}"
                BackgroundColor="{AppThemeBinding Light=#111111, Dark=#111111}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="5,0,5,0"
                Margin="0,-10,0,0"
                HorizontalOptions="Fill">

            <Grid>
                <ScrollView x:Name="ConsoleScrollView"
                            HeightRequest="50"
                            Margin="0,0,0,0"
                            Orientation="Vertical"
                            Scrolled="OnConsoleScrolled">
                    <VerticalStackLayout x:Name="ConsoleStack" Spacing="1" />
                </ScrollView>

                <Button Text="Clear"
                        Padding="0,0"
                        FontSize="12"
                        HeightRequest="24"
                        MinimumHeightRequest="24"
                        WidthRequest="60"
                        Clicked="OnConsoleClearClicked"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,4,0,0"
                        ZIndex="10" />
            </Grid>
        </Border>


        </Grid>

    </ScrollView>

</ContentPage>