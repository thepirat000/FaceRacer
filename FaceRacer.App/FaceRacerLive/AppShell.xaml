<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FaceRacerLive.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FaceRacerLive"
    xmlns:faceRacerLive="clr-namespace:FaceRacerLive"
    Title="FaceRacerLive">

    <ShellContent
        Title="Live"
        FlyoutIcon="live.png"
        ContentTemplate="{DataTemplate faceRacerLive:MainPage}"
        Route="MainPage"/>

    <MenuItem Text="Ranking"
              IconImageSource="ranking.png"
              Clicked="OnRankingClicked" />

    <MenuItem Text="Settings"
              IconImageSource="settings.png"
			  Clicked="OnSettingsClicked" />


</Shell>