<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FaceRacerLive.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FaceRacerLive"
    xmlns:faceRacerLive="clr-namespace:FaceRacerLive"
    Title="FaceRacerLive">

    <ShellContent
        Title="Live"
        ContentTemplate="{DataTemplate faceRacerLive:MainPage}"
        IsEnabled="False"
        Route="MainPage"
        FlyoutItemIsVisible="False"/>

    <MenuItem Text="Tracked racer"
              Clicked="OnTrackedRacerClicked"
              IconImageSource="running_track.png"/>

    <MenuItem Text="Ranking"
              IconImageSource="ranking.png"
              Clicked="OnRankingClicked" />

    <MenuItem Text="Settings"
              IconImageSource="settings.png"
              Clicked="OnSettingsClicked" />

    <Shell.FlyoutFooter>
        <VerticalStackLayout>
            <Button
                Text="Exit"
                HeightRequest="20"
                HorizontalOptions="Start"
                Clicked="OnExitMenuItemClicked"
                ImageSource="exit_icon.png" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>