<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FaceRacerLive.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="FaceRacerLive.SettingsPage"
             Title="Settings"
             x:DataType="viewmodels:SettingsViewModel">

    <ContentPage.Resources>
        <Style x:Key="FormLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="FormEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="FormSectionStyle" TargetType="VerticalStackLayout">
            <Setter Property="Spacing" Value="6" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="FormEditorStyle" TargetType="Editor">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="AutoSize" Value="TextChanges" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="4">

            <Frame Padding="12,5,12,5"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto">
                    <Label Text="Simulation"
                           Style="{StaticResource FormLabelStyle}"
                           VerticalOptions="Center" />

                    <Switch Grid.Column="1"
                            IsToggled="{Binding IsSimulation}"
                            Toggled="OnSimulationToggled"
                            HorizontalOptions="End"
                            VerticalOptions="Center" />
                </Grid>
            </Frame>

            <Frame Padding="12,5,12,5"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                   IsVisible="{Binding IsSimulation}">

                <VerticalStackLayout Style="{StaticResource FormSectionStyle}">
                    <Button Text="Select a zip file" Clicked="OnSelectSimulationZipClicked" />

                    <Label Text="{Binding SimulationZipStatus}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="12,5,12,5"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">

                <VerticalStackLayout Style="{StaticResource FormSectionStyle}">
                    <Label Text="Monitor URL" Style="{StaticResource FormLabelStyle}" />

                    <Editor Text="{Binding CurrentSessionMonitorUrl}"
                            Keyboard="Url"
                            Style="{StaticResource FormEditorStyle}"
                            IsEnabled="True">
                        <Editor.Triggers>
                            <DataTrigger TargetType="Editor"
                                         Binding="{Binding IsSimulation}"
                                         Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}" />
                            </DataTrigger>
                        </Editor.Triggers>
                    </Editor>
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="12,5,12,5"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">

                <VerticalStackLayout Style="{StaticResource FormSectionStyle}">
                    <Label Text="Ranking URL" Style="{StaticResource FormLabelStyle}" />

                    <Editor Text="{Binding MonitorRankingUrl}"
                            Keyboard="Url"
                            Style="{StaticResource FormEditorStyle}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="12,5,12,5"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">

                <VerticalStackLayout Style="{StaticResource FormSectionStyle}">
                    <Label Text="Auto track full name" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding AutoTrackFullName}"
                           Placeholder="Full name"
                           MaxLength="50"
                           Style="{StaticResource FormEntryStyle}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="12,5,12,5"
                   CornerRadius="12"
                   HasShadow="False"
                   BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}">

                <VerticalStackLayout Style="{StaticResource FormSectionStyle}">
                    <Label Text="Live interval (ms)" Style="{StaticResource FormLabelStyle}" />
                    <Entry Text="{Binding IntervalMillisecondsLiveMonitorText}"
                           Keyboard="Numeric"
                           Placeholder="100 - 10000"
                           Style="{StaticResource FormEntryStyle}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="{Binding ValidationError}"
                   TextColor="OrangeRed"
                   FontSize="12"
                   Margin="2,4,2,0" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,12,0,0">
                <Button Text="Cancel" Grid.Column="0" Clicked="OnCancelClicked" />
                <Button Text="Reset" Grid.Column="1" Clicked="OnResetClicked" />
                <Button Text="Save" Grid.Column="2" Clicked="OnSaveClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>