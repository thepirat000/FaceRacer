<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FaceRacerLive.ViewModels"
             x:Class="FaceRacerLive.SettingsPage"
             Title="Settings"
             x:DataType="viewmodels:SettingsViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Label Text="Simulation" VerticalOptions="Center" />
                <Switch IsToggled="{Binding IsSimulation}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Live interval (ms)" />
                <Entry Text="{Binding IntervalMillisecondsLiveMonitorText}"
                       Keyboard="Numeric"
                       Placeholder="100 - 10000" />
                <Label Text="Min: 100, Max: 10000" FontSize="12" TextColor="{AppThemeBinding Light=DarkGray, Dark=Gray}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Current session monitor URL" />
                <Entry Text="{Binding CurrentSessionMonitorUrl}"
                       Keyboard="Url" />
            </VerticalStackLayout>

            <Label Text="{Binding ValidationError}"
                   TextColor="OrangeRed"
                   FontSize="12" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
                <Button Text="Cancel" Grid.Column="0" Clicked="OnCancelClicked" />
                <Button Text="Save" Grid.Column="1" Clicked="OnSaveClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
