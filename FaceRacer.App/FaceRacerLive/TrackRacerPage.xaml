<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FaceRacerLive"
    xmlns:viewmodels="clr-namespace:FaceRacerLive.ViewModels"
    x:Class="FaceRacerLive.TrackRacerPage"
    Title="Track"
    x:DataType="viewmodels:TrackedRacerViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PageBg">#0B0D12</Color>
            <Color x:Key="CardBg">#111827</Color>
            <Color x:Key="CardStroke">#263043</Color>
            <Color x:Key="MutedText">#9CA3AF</Color>
            <Color x:Key="AccentPurple">#A78BFA</Color>
            <Color x:Key="AccentGreen">#34D399</Color>
            <Color x:Key="AccentAmber">#FBBF24</Color>
            <Color x:Key="AccentRed">#FB7185</Color>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource PageBg}" />
            </Style>

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource CardStroke}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Shadow">
                    <Shadow Brush="#000000" Offset="0,8" Radius="14" Opacity="0.35" />
                </Setter>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource MutedText}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Padding="8,0" >
            <Label Grid.Column="0"
                   Margin="-8,0,0,0"
                   Text="Track"
                   TextColor="{StaticResource AccentPurple}"
                   VerticalOptions="Center"
                   LineBreakMode="TailTruncation"
                   FontAttributes="Bold" />

            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <CheckBox x:Name="AutoTrackCheckBox" 
                          VerticalOptions="Center" 
                          CheckedChanged="OnAutoTrackCheckedChanged" 
                          Margin="-6,0,0,0" />
                <Label x:Name="AutoTrackLabel" Text="Auto" FontSize="12" Margin="-10,0,0,0" VerticalOptions="Center" TextColor="#9CA3AF" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAutoTrackLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                <CheckBox x:Name="LiveCheckBox" 
                          VerticalOptions="Center" 
                          CheckedChanged="OnLiveCheckedChanged" 
                          Margin="-6,0,0,0"
                          IsChecked="{Binding IsLiveEnabled, Mode=TwoWay}"/>
                <Label x:Name="LiveLabel" Text="Live" FontSize="12" Margin="-10,0,0,0" VerticalOptions="Center" TextColor="#9CA3AF" >
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLiveLabelTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </Grid>
    </Shell.TitleView>

    <VerticalStackLayout Padding="5,0,5,0" Spacing="0">
        <!-- Session header -->
        <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="10,3,10,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#121826" Offset="0" />
                    <GradientStop Color="DarkBlue" Offset="0.55" />
                    <GradientStop Color="#121826" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,10" Radius="18" Opacity="0.35" />
            </Border.Shadow>
            
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,Auto" RowSpacing="0">
                <Label Grid.Row="0"
                       Grid.Column="0"
                       LineBreakMode="TailTruncation"
                       VerticalTextAlignment="Center"
                       HorizontalTextAlignment="Start">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Session " FontSize="10" TextColor="#C7CEDB" />
                            <Span Text="{Binding SessionNumber, StringFormat='#{0}'}" FontSize="16" TextColor="#E5E7EB" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <Label Grid.Row="0"
                       Grid.Column="1"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center"
                       TextColor="#E5E7EB">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Karts " FontSize="10" TextColor="#C7CEDB" />
                            <Span Text="{Binding TotalKarts}" FontSize="16" TextColor="#E5E7EB" FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>

                </Label>

                <ProgressBar Grid.Row="1"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"
                             HeightRequest="8"
                             Margin="0,0,0,0"
                             Progress="{Binding SessionProgress}"
                             ProgressColor="{Binding SessionProgressColor}"
                             BackgroundColor="#2A3345" />
            </Grid>
        </Border>

        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                <!-- Tracked racer panel -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,5,10,5">

                    <VerticalStackLayout Spacing="0">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="1"
                                   Text="{Binding FullName}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TextColor="#E5E7EB" />

                            <Label Grid.Column="0"
                                   Text="{Binding Kart}"
                                   TextColor="{Binding KartColor}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   Padding="0,0,0,0"
                                   HorizontalTextAlignment="Start"
                                   VerticalTextAlignment="Center" />

                            <Label Grid.Column="2"
                                   VerticalTextAlignment="Center"
                                   Margin="0,-5,0,0">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="# " FontSize="14" TextColor="#C7CEDB" />
                                        <Span Text="{Binding PositionText}" FontSize="24" TextColor="{Binding PositionColor}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>

                        <BoxView HeightRequest="1" Margin="0,0,0,0" BackgroundColor="#243047" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                            <Label Grid.Column="0"
                                   Grid.ColumnSpan="1"
                                   Text="Lap"
                                   FontSize="16"
                                   HorizontalTextAlignment="Start"
                                   Padding="0,5,0,0"
                                   TextColor="#C7CEDB"
                                   VerticalTextAlignment="Center" />

                            <Label Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource AccentPurple}"
                                   VerticalTextAlignment="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Lap}" FontSize="28" />
                                        <Span Text="/" FontSize="15" />
                                        <Span Text="{Binding TotalLaps}" FontSize="15" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label Grid.Column="2"
                                   Grid.ColumnSpan="1"
                                   Text="{Binding PassedTimeText}"
                                   FontSize="16"
                                   HorizontalTextAlignment="End"
                                   Padding="0,5,0,0"
                                   TextColor="#C7CEDB"
                                   VerticalTextAlignment="Center" />
                        </Grid>

                        <ProgressBar HeightRequest="2"
                                     Progress="{Binding LapProgress}"
                                     Margin="0,0,0,10"
                                     ProgressColor="{StaticResource AccentPurple}"
                                     BackgroundColor="#2A3345" />

                        <!-- Last and Best times -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                            <Border x:Name="LastTimeCard"
                                    Grid.Column="0"
                                    StrokeThickness="1"
                                    Stroke="#223047"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="#0F172A"
                                    Padding="10,5,3,3">
                                <VerticalStackLayout Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" 
                                               HorizontalTextAlignment="Center" 
                                               Margin="0,-5,0,0"
                                               FontSize="11"
                                               TextColor="{StaticResource MutedText}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Last lap " />
                                                    <Span Text="{Binding LastLapNumber}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label x:Name="LastTimeValue"
                                               Grid.Column="0"
                                               Text="{Binding LastTime}"
                                               Padding="0,20,0,0"
                                               Margin="0,-5,0,0"
                                               FontSize="26"
                                               TextColor="#E5E7EB"
                                               HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding ArrowIcon}"
                                               FontSize="20"
                                               Padding="0,18,0,0"
                                               FontAttributes="Bold"
                                               TextColor="{Binding ArrowColor}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               WidthRequest="16" />
                                    </Grid>
                                    <Label Text="{Binding BestDeltaPrevText}"
                                           FontSize="13"
                                           TextColor="{StaticResource AccentRed}"
                                           LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="Center"
                                           Margin="0,0,0,0" />
                                    <Label Text="{Binding PrevFullName}"
                                           FontSize="10"
                                           TextColor="{StaticResource AccentRed}"
                                           LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="Center"
                                           Margin="0,0,0,0" />
                                </VerticalStackLayout>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsLastTimeHot}" Value="True">
                                        <Setter Property="Stroke" Value="#3B82F6" />
                                        <Setter Property="BackgroundColor" Value="#0B1B44" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>

                            <Border x:Name="BestTimeCard"
                                    Grid.Column="1"
                                    StrokeThickness="1"
                                    Stroke="#1F3B2E"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="#071A14"
                                    Padding="10,5,3,3">
                                <VerticalStackLayout Spacing="2">
                                    <Label FontSize="11"
                                           Margin="0,-5,0,0"
                                           TextColor="{StaticResource MutedText}"
                                           HorizontalTextAlignment="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Best lap " />
                                                <Span Text="{Binding BestLapNumber}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label x:Name="BestTimeValue"
                                           Text="{Binding BestTime}"
                                           FontSize="32"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           Margin="0,-5,0,0"
                                           TextColor="{StaticResource AccentGreen}" />
                                    <Label Text="{Binding BestDeltaNextText}"
                                           FontSize="13"
                                           TextColor="{StaticResource AccentGreen}"
                                           LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="Center"
                                           Margin="0,-4,0,0" />
                                    <Label Text="{Binding NextFullName}"
                                           FontSize="10"
                                           TextColor="{StaticResource AccentGreen}"
                                           LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="Center"
                                           Margin="0,-4,0,0" />
                                </VerticalStackLayout>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsBestTimeHot}" Value="True">
                                        <Setter Property="Stroke" Value="#22C55E" />
                                        <Setter Property="BackgroundColor" Value="#0B2F23" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Lap times list & Average -->
                <Grid Grid.Row="1" ColumnDefinitions="50*,50*" ColumnSpacing="2">
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="6,0,6,0">

                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Margin="0,0,0,0"
                                       Text="Laps"
                                       Style="{StaticResource SectionTitleStyle}" />
                            </Grid>

                            <CollectionView
                                ItemsSource="{Binding Laps}"
                                SelectionMode="None"
                                ItemSizingStrategy="MeasureFirstItem">

                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:LapTimeRowViewModel">
                                        <Grid Padding="5,0">
                                            <Grid.Triggers>
                                                <DataTrigger TargetType="Grid" Binding="{Binding IsFastest}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF5CC, Dark=#011566}" />
                                                </DataTrigger>
                                            </Grid.Triggers>

                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="2" RowSpacing="0">
                                                <Label Grid.Column="0"
                                                   Text="{Binding LapNumber, StringFormat='{0}. '}"
                                                   FontSize="11"
                                                   VerticalTextAlignment="Center"
                                                   TextColor="{AppThemeBinding Light=DarkGray, Dark=LightGray}" />
                                                <Label Grid.Column="1"
                                                   Text="{Binding Time}"
                                                   FontSize="13"
                                                   VerticalTextAlignment="Center" />
                                                <Label Grid.Column="2"
                                                       Text="{Binding DiffPrevious}"
                                                       TextColor="Gray"
                                                       FontSize="12"
                                                       VerticalTextAlignment="Center" />
                                                <Label Grid.Column="3"
                                                   Text="{Binding ArrowIcon}"
                                                   FontSize="12"
                                                   Margin="0,-2,0,0"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding ArrowColor}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   WidthRequest="18" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <!-- Average -->
                        <Border MaximumHeightRequest="80"
                                HeightRequest="80"
                                VerticalOptions="Start"
                                Style="{StaticResource CardBorderStyle}"
                                Padding="12">

                            <VerticalStackLayout Spacing="2">
                                <Label Text="Average"
                                       Margin="0,-5,0,0"
                                       Style="{StaticResource SectionTitleStyle}" />
                                <Label Text="{Binding AverageLapTime}"
                                       FontSize="24"
                                       HorizontalTextAlignment="Center"
                                       TextColor="#E5E7EB" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Graph -->
                        <Border MaximumHeightRequest="100"
                                HeightRequest="100"
                                VerticalOptions="Start"
                                Style="{StaticResource CardBorderStyle}"
                                Padding="6,2">
                            <GraphicsView
                                x:Name="LapTimesGraph"
                                HeightRequest="100"
                                Margin="0,0,0,0"
                                Drawable="{Binding LapTimesGraphDrawable}" />
                        </Border>

                        <Button Text="Clear"
                                Padding="0,0"
                                HeightRequest="24"
                                MinimumHeightRequest="24"
                                WidthRequest="60"
                                FontSize="12"
                                HorizontalOptions="End"
                                Command="{Binding ClearLapsCommand}" />

                    </VerticalStackLayout>

                </Grid>

                <!-- Mini Racer List (Top 3) -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="2,2,2,2">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Top 5" Margin="0,0,0,0" Style="{StaticResource SectionTitleStyle}" />

                        <CollectionView ItemsSource="{Binding MiniRacers}" SelectionMode="None" ItemSizingStrategy="MeasureFirstItem">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:MiniRacerRowViewModel">
                                    <Grid Padding="6,0,6,0">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer NumberOfTapsRequired="2"
                                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type local:TrackRacerPage}}, Path=BindingContextMiniRacerDoubleTappedCommand}"
                                                                  CommandParameter="{Binding Racer.FullName}" />
                                        </Grid.GestureRecognizers>
                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid" Binding="{Binding Racer.IsHighlighted}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#111B3D" />
                                            </DataTrigger>
                                        </Grid.Triggers>

                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0"
                                               Text="{Binding Racer.PositionText, StringFormat='#{0}'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               VerticalTextAlignment="Center"
                                               TextColor="#E5E7EB" />
                                            <Label Grid.Column="1"
                                               Text="{Binding Racer.FullName}"
                                               FontSize="12"
                                               LineBreakMode="TailTruncation"
                                               VerticalTextAlignment="Center"
                                               TextColor="#E5E7EB" />
                                            <Label Grid.Column="2"
                                               Text="{Binding Racer.Kart}"
                                               FontSize="12"
                                               TextColor="{Binding Racer.KartColor}"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center" />
                                            <Label Grid.Column="3"
                                               Text="{Binding Racer.BestTime}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center"
                                               TextColor="#E5E7EB" />
                                            <Label Grid.Column="4"
                                               Text="{Binding BestDeltaPrev}"
                                               FontSize="12"
                                               TextColor="DarkGray"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center"
                                               WidthRequest="56" />
                                            <Label Grid.Column="5"
                                               Text="{Binding Racer.ArrowIcon}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{Binding Racer.ArrowColor}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"
                                               WidthRequest="16" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
        </Grid>

    </VerticalStackLayout>

</ContentPage>
